# FRR alternate: embedded OpenShift FRR image. node-exporter is embedded too.
# No frr RPM.
#   podman build -f Containerfile --secret id=dockerconfig,src="${CONTAINER_AUTH_FILE:-$HOME/.docker/config.json}" --build-arg BOOTC_BASE=... .
ARG BOOTC_BASE=registry.redhat.io/rhel10/rhel-bootc
FROM ${BOOTC_BASE}

ARG FRR_IMAGE=registry.redhat.io/openshift4/frr-rhel9@sha256:82fd7cc0123f6286bad46231a9939799ae79c30b9369047d2ffd109dacefa76e
ARG NODE_EXPORTER_IMAGE=registry.redhat.io/openshift4/ose-prometheus-node-exporter-rhel9@sha256:7d2884dc16f902e31b897d475d3e0dc09bc735df16b22544d0fefc4396a0ca48

# Package versions are not pinned; they follow the base image's repositories.
# hadolint ignore=DL3041
RUN dnf install -y \
    wireguard-tools \
    libreswan \
    tcpdump \
    traceroute \
    mtr \
    bind-utils \
    python3 \
    iproute \
    nmstate \
    podman \
    skopeo \
    openssh-server \
    cloud-init \
    && dnf clean all

# Host /etc/frr is mounted over the image's config, so the packaged daemons
# file inside the FRR image is hidden. This file is only bgpd and bfdd.
RUN mkdir -p /etc/frr && printf '%s\n' 'bgpd=yes' 'bfdd=yes' > /etc/frr/daemons

RUN --mount=type=secret,id=dockerconfig,target=/root/.docker/config.json \
    mkdir -p /usr/lib/containers-image-cache/frr /usr/lib/containers-image-cache/node-exporter \
    && skopeo copy --preserve-digests \
        "docker://${FRR_IMAGE}" \
        dir:/usr/lib/containers-image-cache/frr \
    && skopeo copy --preserve-digests \
        "docker://${NODE_EXPORTER_IMAGE}" \
        dir:/usr/lib/containers-image-cache/node-exporter

RUN cat > /etc/sysctl.d/99-ip-forward.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
EOF

RUN mkdir -p /etc/wireguard && chmod 700 /etc/wireguard

COPY payload-load.sh /usr/libexec/evpn-appliance/payload-load.sh
COPY payload-load.service /etc/systemd/system/payload-load.service
COPY node-exporter.service /etc/systemd/system/node-exporter.service
COPY frr-container.service /etc/systemd/system/frr-container.service

RUN chmod 755 /usr/libexec/evpn-appliance/payload-load.sh \
    && systemctl enable payload-load.service frr-container.service node-exporter.service

LABEL description="EVPN Migration Appliance"
LABEL version="0.1.0"
LABEL prototype=frr-embed
