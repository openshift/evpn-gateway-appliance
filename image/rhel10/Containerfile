# Stream rhel10. FRR and node-exporter are logically bound container images.
# CI passes --build-arg BOOTC_BASE to the public CentOS Stream bootc image.
ARG BOOTC_BASE=registry.redhat.io/rhel10/rhel-bootc

FROM ${BOOTC_BASE} AS payload-render

RUN dnf install -y python3 python3-pyyaml && dnf clean all
COPY payload-images.yaml /src/payload-images.yaml
COPY tools/payload.py /src/tools/payload.py
COPY rhel10/frr.container.in rhel10/node-exporter.container.in /src/templates/
RUN mkdir -p /generated \
    && python3 /src/tools/payload.py render \
        --inventory /src/payload-images.yaml \
        --stream rhel10 \
        --templates /src/templates \
        --output /generated

FROM ${BOOTC_BASE}

RUN dnf install -y \
    wireguard-tools \
    libreswan \
    tcpdump \
    traceroute \
    mtr \
    bind-utils \
    python3 \
    iproute \
    podman \
    && dnf clean all

# Host /etc/frr is mounted over the image config, so ship daemons on the host.
RUN mkdir -p /etc/frr && printf '%s\n' 'bgpd=yes' 'bfdd=yes' > /etc/frr/daemons

RUN cat > /etc/sysctl.d/99-ip-forward.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
EOF

RUN mkdir -p /etc/wireguard && chmod 700 /etc/wireguard

COPY --from=payload-render /generated/frr.container /generated/node-exporter.container /usr/share/containers/systemd/
RUN mkdir -p /usr/lib/bootc/bound-images.d \
    && ln -sf /usr/share/containers/systemd/frr.container /usr/lib/bootc/bound-images.d/frr.container \
    && ln -sf /usr/share/containers/systemd/node-exporter.container /usr/lib/bootc/bound-images.d/node-exporter.container

LABEL description="EVPN Migration Appliance"
LABEL version="0.1.0"
