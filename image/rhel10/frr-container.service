[Unit]
Description=FRR from the embedded image
After=payload-load.service
Requires=payload-load.service
ConditionPathExists=/etc/frr/frr.conf

[Service]
Restart=always
RuntimeDirectory=frr
RuntimeDirectoryMode=0777
ExecStartPre=-/usr/bin/podman rm -f frr
# FRR installs its own capability set at startup and exits if that fails, so grant
# its daemons' set plus what watchfrr needs to own the vty sockets.
ExecStart=/usr/bin/podman run --pull=never --name frr --rm \
    --network host \
    --cap-drop=all \
    --cap-add=NET_ADMIN --cap-add=SYS_ADMIN --cap-add=NET_RAW \
    --cap-add=NET_BIND_SERVICE --cap-add=SETUID --cap-add=SETGID --cap-add=KILL \
    --cap-add=DAC_OVERRIDE --cap-add=CHOWN \
    --security-opt=no-new-privileges \
    -v /etc/frr:/etc/frr:Z -v /var/run/frr:/var/run/frr:Z frr:embedded
ExecStop=/usr/bin/podman stop frr

[Install]
WantedBy=multi-user.target
