ARG APPLIANCE_IMAGE
FROM ${APPLIANCE_IMAGE}

USER 0
RUN dnf install -y skopeo curl && dnf clean all
RUN mkdir -p /usr/libexec/ega /etc/containers/systemd/frr.container.d \
    /etc/containers/systemd/node-exporter.container.d

COPY ci/storage.conf /etc/containers/storage.conf
COPY tools/payload.py /usr/libexec/ega/payload.py
COPY ci/ega-payload-load.service /usr/lib/systemd/system/ega-payload-load.service
COPY ci/ega-payload-dropin.conf /etc/containers/systemd/frr.container.d/ega-payload.conf
COPY ci/ega-payload-dropin.conf /etc/containers/systemd/node-exporter.container.d/ega-payload.conf

RUN mkdir -p /usr/lib/ega/payload-cache
RUN --mount=type=secret,id=registry-auth,target=/run/secrets/registry-auth \
    python3 /usr/libexec/ega/payload.py cache \
      --units /usr/lib/bootc/bound-images.d \
      --output /usr/lib/ega/payload-cache \
      --authfile /run/secrets/registry-auth

ENV container=podman
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
