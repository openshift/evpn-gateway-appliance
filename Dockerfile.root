# CI image for the static source checks (`make verify`).
# Tool versions are pinned; the base is a CI-managed tag.
# ansible-core 2.21 requires Python >= 3.12.
FROM registry.ci.openshift.org/ocp/ubi-python-312:9

# Base does not run as root by default and we need it so that the project src
# can be copied to /go/src/...
USER 0

# Pinned lint/build toolchain (matches the collection's CI pins).
RUN pip install --no-cache-dir \
        ansible-core==2.21.4 \
        ansible-lint==26.8.0 \
        yamllint==1.38.0

# markdownlint-cli2 requires Node >=22; use the base runtime and enforce package engines.
COPY ci/markdownlint/package.json ci/markdownlint/package-lock.json /opt/markdownlint/
RUN npm ci --prefix /opt/markdownlint --omit=dev --ignore-scripts --engine-strict --no-audit --no-fund \
    && npm cache clean --force \
    && ln -s /opt/markdownlint/node_modules/.bin/markdownlint-cli2 /usr/local/bin/markdownlint-cli2
