! On-prem EVPN Appliance — VTEP endpoint
! Managed by Ansible — do not edit manually
!
! KNOWN OPEN ITEM: no route-map/prefix-list policy; maximum-prefix below is only a defensive backstop (source-audit.md §1, "No BGP policy or limits").
! frr version line derived from frr_image; revisit if frr_image moves to digest pinning.
frr version {{ frr_image.split(":")[-1] }}
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
router bgp {{ bgp.onprem_asn }}
 bgp router-id {{ tunnel.onprem_ip }}
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 !
 neighbor {{ tunnel.cloud_ip }} remote-as {{ bgp.infra_asn }}
 neighbor {{ tunnel.cloud_ip }} description infra-relay
 !
 address-family ipv4 unicast
  network {{ tunnel.network_cidr | default('10.44.44.0/24') }}
  neighbor {{ tunnel.cloud_ip }} activate
  neighbor {{ tunnel.cloud_ip }} soft-reconfiguration inbound
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor {{ tunnel.cloud_ip }} activate
  neighbor {{ tunnel.cloud_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
  advertise-all-vni
{% for s in stretches %}
{% set vni = 10000 + s.vlan %}
  vni {{ vni }}
   rd {{ tunnel.onprem_ip }}:{{ vni }}
   rt import {{ bgp.onprem_asn }}:{{ vni }}
   rt import {{ bgp.workload_asn }}:{{ vni }}
   rt export {{ bgp.onprem_asn }}:{{ vni }}
   advertise-svi-ip
  exit-vni
{% endfor %}
 exit-address-family
exit
!
ip route {{ tunnel.network_cidr | default('10.44.44.0/24') }} blackhole
!
end
