! On-prem EVPN Appliance — VTEP endpoint
! Managed by Ansible — do not edit manually
!
{% if tunnel.type == 'ipsec' %}
! AWS underlay IPv4 policy is limited to the VTEP network outbound and VPC networks inbound; EVPN maximum-prefix remains a defensive backstop (source-audit.md §1, "No BGP policy or limits").
{% else %}
! KNOWN OPEN ITEM: no route-map/prefix-list policy; maximum-prefix below is only a defensive backstop (source-audit.md §1, "No BGP policy or limits").
{% endif %}
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
{% set evpn_peer = hostvars[infra_relay_host].private_ip if tunnel.type == 'ipsec' else tunnel.cloud_ip %}
{% if tunnel.type == 'ipsec' %}
ip prefix-list EGA-AWS-OUT seq 5 permit {{ tunnel.network_cidr | default('10.44.44.0/24') }}
ip prefix-list EGA-AWS-IN seq 5 permit {{ infra_vpc_cidr | default('10.100.0.0/16') }}
ip prefix-list EGA-AWS-IN seq 10 permit {{ workload_vpc_cidr | default('10.200.0.0/16') }}
!
{% endif %}
router bgp {{ bgp.onprem_asn }}
 bgp router-id {{ tunnel.onprem_ip }}
 bgp log-neighbor-changes
 bgp graceful-restart
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 !
{% if tunnel.type == 'ipsec' %}
{# AWS VPN BGP uses keepalive 10 s and hold 30 s. No graceful restart toward AWS: as its helper, AWS would keep
   routing to the appliance through a failed tunnel after the hold time instead of moving to the other one. #}
{% for t in _evpn_onprem_appliance_ipsec_peers %}
 neighbor {{ t.aws_inside_ip }} remote-as {{ t.aws_bgp_asn }}
 neighbor {{ t.aws_inside_ip }} description aws-vpn-{{ loop.index }}
 neighbor {{ t.aws_inside_ip }} update-source {{ t.cgw_inside_ip }}
 neighbor {{ t.aws_inside_ip }} timers 10 30
 neighbor {{ t.aws_inside_ip }} timers connect 10
 neighbor {{ t.aws_inside_ip }} graceful-restart-disable
{% endfor %}
{% endif %}
 neighbor {{ evpn_peer }} remote-as {{ bgp.infra_asn }}
 neighbor {{ evpn_peer }} description infra-relay
{% if tunnel.type == 'ipsec' %}
 neighbor {{ evpn_peer }} ebgp-multihop 4
 neighbor {{ evpn_peer }} update-source {{ tunnel.onprem_ip }}
{% endif %}
 !
 address-family ipv4 unicast
  network {{ tunnel.network_cidr | default('10.44.44.0/24') }}
{% if tunnel.type == 'ipsec' %}
{% for t in _evpn_onprem_appliance_ipsec_peers %}
  neighbor {{ t.aws_inside_ip }} activate
  neighbor {{ t.aws_inside_ip }} prefix-list EGA-AWS-OUT out
  neighbor {{ t.aws_inside_ip }} prefix-list EGA-AWS-IN in
  neighbor {{ t.aws_inside_ip }} soft-reconfiguration inbound
{% endfor %}
{% else %}
  neighbor {{ evpn_peer }} activate
  neighbor {{ evpn_peer }} soft-reconfiguration inbound
{% endif %}
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor {{ evpn_peer }} activate
  neighbor {{ evpn_peer }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
  advertise-all-vni
{% for s in stretches %}
{% set vni = 10000 + s.vlan %}
  vni {{ vni }}
   rd {{ tunnel.onprem_ip }}:{{ vni }}
   route-target import {{ bgp.onprem_asn }}:{{ vni }}
   route-target import {{ bgp.workload_asn }}:{{ vni }}
   route-target export {{ bgp.onprem_asn }}:{{ vni }}
   advertise-svi-ip
  exit-vni
{% endfor %}
 exit-address-family
exit
!
ip route {{ tunnel.network_cidr | default('10.44.44.0/24') }} blackhole
!
end
