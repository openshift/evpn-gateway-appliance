---
# Managed by the evpn_onprem_appliance role (CORENET-7499). Rendered and applied with
# nmstatectl. nmstate reconciles current -> desired (create/modify/recreate) and verifies.
# Interface names stay conventional; ownership is carried by the NM profile name (ega-*) set
# via profile-name. The trunk NIC carries one 802.1Q VLAN sub-interface per stretch; each
# sub-interface is a port of that stretch's VNI bridge, holding the SVI next to a VXLAN port.
#
# One dispatcher remains for the VXLAN neigh_suppress flag, which nmstate cannot express.
interfaces:
  - name: {{ trunk_interface }}
    type: ethernet
    state: up
    profile-name: ega-port-{{ trunk_interface }}
    ipv4: {enabled: false}
    ipv6: {enabled: false}
{% for s in stretches %}
{% set vni = 10000 + s.vlan %}
  - name: {{ trunk_interface }}.{{ s.vlan }}
    type: vlan
    state: up
    profile-name: ega-vlan-{{ s.vlan }}
    vlan: {base-iface: {{ trunk_interface }}, id: {{ s.vlan }}}
  - name: vxlan{{ vni }}
    type: vxlan
    state: up
    profile-name: ega-vxlan-{{ vni }}
    vxlan: {id: {{ vni }}, local: {{ tunnel.onprem_ip }}, destination-port: 4789, learning: false}
  - name: br-vni{{ vni }}
    type: linux-bridge
    state: up
    profile-name: ega-bridge-vni{{ vni }}
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: {{ s.onprem_gateway }}
          prefix-length: {{ s.subnet | ansible.utils.ipaddr('prefix') }}
    ipv6: {enabled: false}
    bridge:
      options:
        stp: {enabled: false}
      port:
        - name: vxlan{{ vni }}
        - name: {{ trunk_interface }}.{{ s.vlan }}
{% endfor %}
{% for iface in _ega_absent | default([]) %}
  - name: {{ iface }}
    state: absent
{% endfor %}
