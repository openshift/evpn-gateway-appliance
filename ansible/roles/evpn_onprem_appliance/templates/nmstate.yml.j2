---
# Managed by the evpn_onprem_appliance role (CORENET-7499). Rendered and applied with
# nmstatectl. nmstate reconciles current -> desired (create/modify/recreate) and verifies.
# Interface names stay conventional; the profiles we create carry ownership via their NM
# profile name (ega-*). The trunk itself is NOT owned: we attach it to the vlan-aware trunk
# bridge as a trunk port, which nmstate does by editing the trunk's existing profile in place
# (a partial merge) — so any pre-existing config (e.g. an LACP bond) is preserved and we do not
# restate it. Each stretch gets a VNI bridge (holding the SVI) with a VXLAN port and a VLAN
# sub-interface port.
#
# Two things nmstate cannot express, handled by dispatchers: trunk-br's own VLAN membership
# and the VXLAN neigh_suppress flag.
#
# The desired state is a pure function of `stretches`: with none, the present body is suppressed and only
# the two companion lists render. _evpn_onprem_appliance_detach lists interfaces enslaved to trunk-br other than the desired
# trunk; each is detached with controller: "" so nmstate clears the controller from its (foreign, non-ega)
# profile and persists it. This handles swapping the trunk (detach the old one) and teardown (no desired
# trunk, so detach all). _evpn_onprem_appliance_absent lists ega-* interfaces no longer desired, marked absent.
interfaces:
{# Outside teardown, ipsec and direct-connect add the VTEP dummy holding tunnel.onprem_ip. #}
{% if (tunnel | default({})).type | default('wireguard') != 'wireguard' and not (_evpn_onprem_appliance_teardown | default(false)) %}
  - name: ega-vtep
    type: dummy
    state: up
    profile-name: ega-dummy-vtep
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: {{ tunnel.onprem_ip }}
          prefix-length: 32
    ipv6: {enabled: false}
{% endif %}
{% if stretches | length > 0 %}
  - name: trunk-br
    type: linux-bridge
    state: up
    profile-name: ega-bridge-trunk
    ipv4: {enabled: false}
    ipv6: {enabled: false}
    bridge:
      options:
        stp: {enabled: false}
      port:
        - name: {{ trunk_interface }}
          vlan:
            mode: trunk
            trunk-tags:
{% for s in stretches %}
              - id: {{ s.vlan }}
{% endfor %}
{% for s in stretches %}
{% set vni = 10000 + s.vlan %}
  - name: trunk.{{ s.vlan }}
    type: vlan
    state: up
    profile-name: ega-vlan-{{ s.vlan }}
    vlan: {base-iface: trunk-br, id: {{ s.vlan }}}
  - name: vxlan{{ vni }}
    type: vxlan
    state: up
    profile-name: ega-vxlan-{{ vni }}
    vxlan: {id: {{ vni }}, local: {{ tunnel.onprem_ip }}, destination-port: 4789, learning: false}
  - name: br-vni{{ vni }}
    type: linux-bridge
    state: up
    profile-name: ega-bridge-vni{{ vni }}
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: {{ s.onprem_gateway }}
          prefix-length: {{ s.subnet | ansible.utils.ipaddr('prefix') }}
    ipv6: {enabled: false}
    bridge:
      options:
        stp: {enabled: false}
      port:
        - name: vxlan{{ vni }}
        - name: trunk.{{ s.vlan }}
{% endfor %}
{% endif %}
{% for iface in _evpn_onprem_appliance_detach | default([]) %}
  - name: {{ iface }}
    controller: ""
{% endfor %}
{% for iface in _evpn_onprem_appliance_absent | default([]) %}
  - name: {{ iface }}
    state: absent
{% endfor %}
{% if (tunnel | default({})).type | default('wireguard') != 'wireguard' and not (_evpn_onprem_appliance_teardown | default(false)) %}
{# While no transport path provides a route to a VPC, kernel policy rules drop its traffic rather than send it by a
   covering route: suppress-prefix-length skips main-table routes shorter than the VPC prefix, so only a transport
   route matches (AWS's over IPsec, FRR's statics over Direct Connect); otherwise the next rule blackholes. The route
   to ega-vtep's own address keeps the rules on its profile (nmstate stores rules with an interface routing to their
   table), so removing a stretch's bridge cannot delete them. A VPC CIDR or onprem_ip change requires teardown
   first: nmstate merges rules rather than replacing them. #}
routes:
  config:
    - destination: {{ tunnel.onprem_ip }}/32
      next-hop-interface: ega-vtep
      table-id: 254
route-rules:
  config:
{% for cidr in [infra_vpc_cidr | default('10.100.0.0/16'), workload_vpc_cidr | default('10.200.0.0/16')] %}
    - ip-to: {{ cidr }}
      priority: {{ 3000 + 2 * loop.index0 }}
      route-table: 254
      suppress-prefix-length: {{ (cidr | ansible.utils.ipaddr('prefix')) - 1 }}
    - ip-to: {{ cidr }}
      priority: {{ 3001 + 2 * loop.index0 }}
      action: blackhole
{% endfor %}
{% endif %}
