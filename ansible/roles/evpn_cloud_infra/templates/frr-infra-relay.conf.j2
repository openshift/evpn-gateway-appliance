! Infra VPC Router — EVPN route relay (NOT a VTEP)
! Managed by Ansible — do not edit manually
!
! KNOWN OPEN ITEM: no route-map/prefix-list/route-target policy; maximum-prefix below is only a defensive backstop (source-audit.md §1, "No BGP policy or limits").
! frr version line derived from frr_image; revisit if frr_image moves to digest pinning.
frr version {{ frr_image.split(":")[-1] }}
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
router bgp {{ bgp.infra_asn }}
 bgp router-id {{ private_ip }}
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 !
{% set workload_host = hostvars[workload_vtep_host] %}
 neighbor {{ workload_host.private_ip }} remote-as {{ bgp.workload_asn }}
 neighbor {{ workload_host.private_ip }} description workload-vtep
 neighbor {{ workload_host.private_ip }} ebgp-multihop 4
 !
 neighbor {{ tunnel.onprem_ip }} remote-as {{ bgp.onprem_asn }}
 neighbor {{ tunnel.onprem_ip }} description onprem-appliance
 !
 address-family ipv4 unicast
  network {{ private_ip }}/32
  neighbor {{ workload_host.private_ip }} activate
  neighbor {{ workload_host.private_ip }} soft-reconfiguration inbound
  neighbor {{ tunnel.onprem_ip }} activate
  neighbor {{ tunnel.onprem_ip }} soft-reconfiguration inbound
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor {{ workload_host.private_ip }} activate
  neighbor {{ workload_host.private_ip }} next-hop-unchanged
  neighbor {{ workload_host.private_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
  neighbor {{ tunnel.onprem_ip }} activate
  neighbor {{ tunnel.onprem_ip }} next-hop-unchanged
  neighbor {{ tunnel.onprem_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
 exit-address-family
exit
!
end
