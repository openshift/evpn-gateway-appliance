! Infra VPC Router — EVPN route relay (NOT a VTEP)
! Managed by Ansible — do not edit manually
!
! KNOWN OPEN ITEM: no route-map/prefix-list/route-target policy; maximum-prefix below is only a defensive backstop (source-audit.md §1, "No BGP policy or limits").
! frr version line derived from frr_image; revisit if frr_image moves to digest pinning.
frr version {{ frr_image.split(":")[-1] }}
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
router bgp {{ bgp.infra_asn }}
 bgp router-id {{ private_ip }}
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 !
{% set workload_host = hostvars[workload_vtep_host] %}
 neighbor {{ workload_host.private_ip }} remote-as {{ bgp.workload_asn }}
 neighbor {{ workload_host.private_ip }} description workload-vtep
 neighbor {{ workload_host.private_ip }} ebgp-multihop 4
 !
{# IPsec gives each appliance its own VTEP; the relay peers with all of them. #}
{% if tunnel.type == 'ipsec' %}
{% set onprem_peers = groups['onprem_appliances'] | map('extract', hostvars) | list %}
{% else %}
{% set onprem_peers = [{'tunnel': tunnel, 'bgp': bgp}] %}
{% endif %}
{% for a in onprem_peers %}
 neighbor {{ a.tunnel.onprem_ip }} remote-as {{ a.bgp.onprem_asn }}
 neighbor {{ a.tunnel.onprem_ip }} description onprem-appliance
{% if tunnel.type != 'wireguard' %}
 neighbor {{ a.tunnel.onprem_ip }} ebgp-multihop {{ 255 if tunnel.type == 'direct-connect' else 4 }}
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ private_ip }}/32
  neighbor {{ workload_host.private_ip }} activate
  neighbor {{ workload_host.private_ip }} soft-reconfiguration inbound
{% if tunnel.type == 'wireguard' %}
  neighbor {{ tunnel.onprem_ip }} activate
  neighbor {{ tunnel.onprem_ip }} soft-reconfiguration inbound
{% endif %}
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor {{ workload_host.private_ip }} activate
  neighbor {{ workload_host.private_ip }} next-hop-unchanged
  neighbor {{ workload_host.private_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
{% for a in onprem_peers %}
  neighbor {{ a.tunnel.onprem_ip }} activate
  neighbor {{ a.tunnel.onprem_ip }} next-hop-unchanged
  neighbor {{ a.tunnel.onprem_ip }} maximum-prefix {{ bgp.max_prefix | default(1000) }}
{% endfor %}
 exit-address-family
exit
!
end
