# CI image for the static source checks (`make verify`).
# ansible-core 2.21 requires Python >= 3.12.
# The base is not pinned: Prow replaces it with its mutable ubi-python-312:9 image.
# hadolint ignore=DL3007
FROM registry.access.redhat.com/ubi9/python-312:latest

# Marks this as the CI image; the Makefile detects it to run the checks directly
# instead of building/entering a container (delegation recursion guard).
ENV EGA_IN_CI_IMAGE=1

# Run as root
USER 0

# Install necessary package dependencies
# git: the checks run `git ls-files`; trust the root-owned checkout for any runtime UID.
# Package versions are not pinned; they follow the base image's repositories.
# hadolint ignore=DL3041
RUN dnf install -y git && dnf clean all && \
    git config --system --add safe.directory '*'

# Pinned lint/build toolchain (the Ansible tools match the collection's CI pins).
RUN pip install --no-cache-dir \
        ansible-core==2.21.4 \
        ansible-lint==26.8.0 \
        yamllint==1.38.0 \
        ansible-builder==3.1.1 \
        hadolint-py==v2.15.1.2

# Collection dependencies, pinned to exact versions for reproducible image builds and
# so the checks can resolve FQCN modules on the network-less runner. Keep in sync with
# galaxy.yml's ranges; the install smoke in `make check-ansible` (ansible-galaxy install
# --offline against these baked deps) fails if a pin no longer satisfies galaxy.yml.
# Use a throwaway ANSIBLE_HOME so this root step doesn't leave a root-owned ~/.ansible
# in the image HOME (a non-root runtime user couldn't write it). Clear the galaxy
# response cache and delete the throwaway afterward so nothing is left behind.
RUN ANSIBLE_HOME="$(mktemp -d)" && \
    export ANSIBLE_HOME && \
    ansible-galaxy collection install -v --no-deps --clear-response-cache \
        --collections-path /usr/share/ansible/collections \
        amazon.aws:11.5.0 \
        ansible.posix:2.2.2 \
        ansible.utils:6.1.1 \
        containers.podman:1.21.1 && \
    rm -rf "$ANSIBLE_HOME"

# markdownlint-cli2 from the ci/markdownlint lockfile (see its README). Node and npm
# come from the base image; --engine-strict fails the build if that Node is too old.
# npm's cache and logs and Node's compile cache go to a throwaway directory, so this
# root step leaves no root-owned ~/.npm or /tmp/node-compile-cache, like ANSIBLE_HOME.
COPY ci/markdownlint/package.json ci/markdownlint/package-lock.json /opt/markdownlint/
RUN tmp="$(mktemp -d)" && \
    npm_config_cache="$tmp" NODE_COMPILE_CACHE="$tmp" \
        npm ci --prefix /opt/markdownlint --ignore-scripts --engine-strict --no-audit --no-fund && \
    rm -rf "$tmp" && \
    ln -s /opt/markdownlint/node_modules/.bin/markdownlint-cli2 /usr/local/bin/markdownlint-cli2

# Copy the source code into the container
COPY . /src

# Force the source tree read-only: the checks must never write into the checkout
# (build artifacts go out of tree). Surfaces accidental source writes.
RUN chmod -R a-w /src

# Set the working directory to /src
WORKDIR /src

# Return to the base's non-root user for local runs. (OpenShift CI overrides USER with
# its own arbitrary UID regardless; see the ANSIBLE_HOME note above.)
USER 1001
