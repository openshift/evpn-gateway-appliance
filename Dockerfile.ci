# CI image for the static source checks (`make verify`).
# Pinned base + tool versions for reproducible, auditable builds.
# ansible-core 2.21 requires Python >= 3.12.
FROM registry.ci.openshift.org/ocp/ubi-python-312:9

# Run as root
USER 0

# Install necessary package dependencies
RUN dnf install -y git && dnf clean all

# Configure git to allow operations in any directory (for CI purposes)
RUN git config --system --add safe.directory '*'

# Pinned lint/build toolchain (matches the collection's CI pins).
RUN pip install --no-cache-dir \
        ansible-core==2.21.4 \
        ansible-lint==26.8.0 \
        yamllint==1.38.0 \
        ansible-builder==3.1.1

# Collection dependencies, pinned to exact versions for reproducible image builds and
# so the checks can resolve FQCN modules on the network-less runner. Keep in sync with
# galaxy.yml's ranges; the install smoke in `make check-ansible` (ansible-galaxy install
# --offline against these baked deps) fails if a pin no longer satisfies galaxy.yml.
RUN ansible-galaxy collection install --collections-path /usr/share/ansible/collections \
        amazon.aws:11.5.0 \
        ansible.posix:2.2.2 \
        ansible.utils:6.1.1 \
        containers.podman:1.21.1

# Copy the source code into the container
COPY . /src

# Set the working directory to /src
WORKDIR /src
