# L2 reachability on the primary CUDN: same kind fabric as the kind scenario,
# plus a pod the appliance must reach on its stretched address.
EGA_TOPOLOGY=kind.clab.yml
EGA_INVENTORY="${EGA_INVENTORY:-inventory/kind}"
EGA_PLAYBOOKS="${EGA_PLAYBOOKS:-network.evpn_gateway_test.simulate network.evpn_gateway.deploy network.evpn_gateway_test.l2_pod}"
