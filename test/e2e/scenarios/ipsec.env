# Emulated fabric over the IPsec transport, with a simulated AWS VPN endpoint.
EGA_TOPOLOGY=ipsec.clab.yml
EGA_INVENTORY="${EGA_INVENTORY:-inventory/ipsec}"
EGA_PLAYBOOKS="${EGA_PLAYBOOKS:-network.evpn_gateway_test.simulate network.evpn_gateway.deploy network.evpn_gateway_test.healthcheck network.evpn_gateway.teardown network.evpn_gateway_test.teardown_check}"
